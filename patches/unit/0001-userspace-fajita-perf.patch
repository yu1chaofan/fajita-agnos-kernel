+# fajita (OnePlus 6T / SDM845) only.  This overlay is device-agnostic: the same
+# userspace/ tree builds the tici/AGNOS image, so the units must be enabled only
+# in an image that carries the /FAJITA marker, never on tici.
+# The two scripts arrive from the patch as mode 0644 -- the rootfs overlay tar
+# below runs with --mode=go-w and patch(1) cannot carry a mode bit, so the
+# executable bit has to be set here, after the overlay copy and before `enable`.
+chmod 755 /usr/comma/perf_mode.sh /usr/comma/thermal_log.sh
+if [ -e /FAJITA ]; then
+  systemctl enable fajita-perf.service
+  systemctl enable fajita-thermal-log.service
+else
