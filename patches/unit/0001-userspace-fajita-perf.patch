+[Unit]
+# PHASE23 / D2-D3 -- apply the configured fajita perf/thermal mode once at boot.
+#
+# fajita (OnePlus 6T / SDM845) ships no /FAJITA marker yet, so this unit is
+# dormant on every current image, tici/AGNOS included.  The PRIMARY apply point
+# is /usr/comma/comma.sh, right after its two `echo 1689600 > scaling_max_freq`
+# writes -- that is the only place that is strictly ordered against them.
+# This unit is the fallback for the case where comma.service is disabled/failed.
+Description=fajita perf/thermal mode apply (one-shot, fallback path)
+After=local-fs.target comma.service
+ConditionPathExists=/FAJITA
+ConditionPathExists=/usr/comma/perf_mode.sh
+ConditionPathIsDirectory=/sys/class/thermal
+
+[Service]
+Type=oneshot
+RemainAfterExit=yes
+# /persist is mounted read-only on AGNOS (etc/fstab: ro,discard,nosuid,nodev,noexec),
+# so the runtime override lives on userdata instead of /persist/params/perf_mode.
+Environment="CONFIG_FILES=/data/params/fajita-perf_mode /etc/fajita/perf_mode"
+# /var is a 128M tmpfs (etc/fstab), i.e. writable but volatile; the rollback
+# ledger is a boot-time baseline, so losing it on reboot is the correct behaviour.
+Environment=FAJITA_PERF_STATE_DIR=/var/lib/fajita-perf
+# Ordering guard for the fallback path only: comma.sh rewrites policy0/policy4
+# scaling_max_freq to 1689600 at ~t0, and starting before that would let its
+# tee undo our write.  perf_mode.sh is idempotent, so a late run is harmless.
+ExecStartPre=/bin/sleep 5
+# --from-config is the documented entry point.  It was broken in the first
+# phase22 drop (the flag loop swallowed every '-*' token and exited 64); the
+# fixed script -- sha256 4788a0c0…, shipped by this same patch -- parses it via
+# FROM_CONFIG=1.  Bare invocation is now a DELIBERATE usage error there, so this
+# unit must always pass the flag.
+ExecStart=/usr/comma/perf_mode.sh --from-config
+ExecReload=/usr/comma/perf_mode.sh --from-config
+ExecStop=/usr/comma/perf_mode.sh default
+TimeoutStartSec=90
+TimeoutStopSec=60
+StandardOutput=journal
+StandardError=journal
+SyslogIdentifier=fajita-perf
+
+[Install]
+WantedBy=multi-user.target
--- /dev/null
+++ b/userspace/root/usr/lib/systemd/system/fajita-thermal-log.service
@@ -0,0 +1,37 @@
+[Unit]
+# PHASE23 / D3 -- resident thermal/power sampler for fajita.
+#
+# Output directory choice, from the pinned AGNOS etc/fstab at
+# 3c3390f39f9985784b406d1dc37420c1a175915c:
+#   /dev/disk/by-partlabel/persist /persist auto ro,discard,nosuid,nodev,noexec
+#   /dev/disk/by-partlabel/userdata /data  auto discard,noatime,nodiratime,nosuid,nodev,nofail
+#   tmpfs /var tmpfs rw,...,size=128M      tmpfs /tmp tmpfs rw,...,size=150M
+# /persist is READ-ONLY, so the sampler writes to /data/thermal and falls back to
+# /tmp (tmpfs) when userdata did not mount.  No file is ever written under
+# /var/log: readonly_setup.sh does `mv /var /usr/default && mkdir /var`, so the
+# image ships an EMPTY /var and /var/log exists only if tmpfiles creates it.
+Description=fajita thermal/power CSV sampler
+After=local-fs.target
+RequiresMountsFor=/data
+ConditionPathExists=/FAJITA
+ConditionPathExists=/usr/comma/thermal_log.sh
+
+[Service]
+Type=simple
+Restart=always
+RestartSec=10
+# `date -u -Is` keeps the file name free of '%' -- systemd would try to expand a
+# real strftime specifier there, and a slip in that expansion is a silent path bug.
+ExecStart=/bin/sh -c 'D=/data/thermal; if ! mkdir -p "$D" 2>/dev/null || [ ! -w "$D" ]; then D=/tmp/thermal; mkdir -p "$D" 2>/dev/null || D=/tmp; fi; T=$(date -u -Is | tr -d ":"); echo "fajita-thermal-log: writing $D/thermal-$T.csv"; exec /usr/comma/thermal_log.sh --interval=10 --out="$D/thermal-$T.csv"'
+# thermal_log.sh traps TERM with `rm -rf "$WORK"` but never exits: after the trap
+# the sampling loop keeps running against a deleted spec dir and spins on
+# "cannot open .../spec" (measured on the staged bytes, see report section 5.2).
+# SIGKILL it -- the sampler holds no state worth flushing, so no cleanup is lost.
+KillSignal=SIGKILL
+TimeoutStopSec=10
+StandardOutput=journal
+StandardError=journal
+SyslogIdentifier=fajita-thermal-log
+
+[Install]
+WantedBy=multi-user.target
