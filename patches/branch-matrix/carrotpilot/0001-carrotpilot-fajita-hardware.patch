+"""
+OnePlus 6T (fajita / SDM845) hardware implementation for carrotpilot.
+
+Why this class exists
+---------------------
+The port boots an AGNOS-derived sdm845 base, so /AGNOS *and* /TICI both exist on
+the rootfs (both are `touch`ed by base_setup.sh). In this branch the selector in
+openpilot/system/hardware/__init__.py keys off the TICI marker, so a stock build would instantiate
+Tici() on a OnePlus 6T and poke comma-three carrier hardware that is not there
+(hwmon1, BMS, SOM GPIO fan, carrier amplifier). Selection is therefore driven by
+a dedicated /FAJITA marker with priority over TICI; see the patch to the
+selector.
+
+Contract
+--------
+Reference implementation for every override is openpilot/system/hardware/tici/hardware.py.
+Rule: nothing in this file may raise at runtime on a missing /sys or /proc node.
+Every access is existence-checked or wrapped, and degrades to the base-class
+neutral value.
+
+Items marked ASSUMED were not observed on a device and need on-device
+confirmation; see port-doc/PHASE24-BRANCH-PORTS.md.
+"""
+
+import os
+import socket
+import subprocess
+
+from openpilot.cereal import log
+from openpilot.system.hardware.base import HardwareBase, ThermalZone, ThermalConfig
+
+NetworkType = log.DeviceState.NetworkType
+NetworkStrength = log.DeviceState.NetworkStrength
+
+DEVICE_TYPE = "fajita"
+
+#: ASSUMED: same panel backlight node name as tici (both sdm845 + AGNOS kernels).
+#: Verify with: ls /sys/class/backlight/
+BACKLIGHT = "/sys/class/backlight/panel0-backlight"
+KGSL = "/sys/class/kgsl/kgsl-3d0"
+VERSION_FILE = "/VERSION"
+THERMAL_ROOT = "/sys/devices/virtual/thermal"
+DATA_RESET_MARKER = "/data/__system_reset__"
+
+
+def _read(path, default=""):
+  """Read a small sysfs/procfs file; return default when absent (never raises)."""
+  try:
+    with open(path) as f:
+      return f.read()
+  except Exception:
+    return default
+
+
+def _write(path, value):
+  """Best-effort writable-node write; returns False instead of raising."""
+  try:
+    with open(path, "w") as f:
+      f.write(str(value))
+    return True
+  except Exception:
+    return False
+
+
+def _write_sudo(path, value):
+  """Best-effort privileged write via `sudo tee`; returns False instead of raising."""
+  try:
+    with open(os.devnull, "w") as devnull:
+      subprocess.run(["sudo", "tee", path], input=str(value).encode(),
+                     stdout=devnull, stderr=devnull, check=False, timeout=5)
+    return True
+  except Exception:
+    return False
+
+
+def _thermal_zone_index() -> dict:
+  """Map thermal zone type -> index, guarded. ASSUMED names on this kernel."""
+  out = {}
+  try:
+    for n in os.listdir(THERMAL_ROOT):
+      if not n.startswith("thermal_zone"):
+        continue
+      try:
+        idx = int(n.removeprefix("thermal_zone"))
+      except ValueError:
+        continue
+      name = _read(os.path.join(THERMAL_ROOT, n, "type")).strip()
+      if name:
+        out[name] = idx
+  except Exception:
+    pass
+  return out
+
+
+def wpa_supplicant_cmd(cmd: str, timeout: float = 0.2) -> dict:
+  """Query wpa_supplicant over its control socket.
+
+  Same approach as openpilot/system/hardware/tici/hardware.py, duplicated locally on purpose: importing
+  the tici/comma hardware module binds carrier-board GPIO/amplifier at import
+  time.
+  """
+  try:
+    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as sock:
+      sock.settimeout(timeout)
+      sock.bind(f"\0openpilot-wpa-{os.getpid()}-{time.monotonic_ns()}")
+      sock.connect("/run/wpa_supplicant/wlan0")
+      sock.send(cmd.encode())
+      while True:
+        out = sock.recv(8192).decode("utf-8", "replace")
+        if out.startswith("<"):
+          continue
+        if out.startswith("FAIL"):
+          return {}
+        return dict(l.split("=", 1) for l in out.splitlines() if "=" in l)
+  except Exception:
+    return {}
+
+
+def _default_route_iface():
+  """Reference openpilot/system/hardware/tici/hardware.py, with a field-count guard the original lacks."""
+  iface = None
+  try:
+    with open("/proc/net/route") as f:
+      routes = []
+      for line in f.readlines()[1:]:
+        route = line.split()
+        if len(route) > 6 and route[1] == "00000000" and int(route[3], 16) & 0x1:
+          routes.append((int(route[6]), route[0]))
+    iface = min(routes)[1] if routes else None
+  except Exception:
+    iface = None
+  return iface
+
+
+class HardwareFajita(HardwareBase):
+  """OnePlus 6T: SDM845, no fan, no comma amp/IR/panda-GPIO, no managed modem."""
+
+  def get_device_type(self):
+    # tici derives the codename from /sys/firmware/devicetree/base/model; a phone
+    # has no "comma " prefix there, so return a constant (fan_controller.py calls
+    # this at import time).
+    return DEVICE_TYPE
+
+  def get_os_version(self):
+    # tici reads /VERSION unguarded; guarded here. Return "" (not None) because
+    # callers f-string it (setup screens) and compare it as a string (updated.py).
+    return _read(VERSION_FILE).strip()
+
+  def get_serial(self):
+    # tici does get_cmdline()['androidboot.serialno'] -> KeyError when absent.
+    serial = self.get_cmdline().get("androidboot.serialno", "")
+    if serial:
+      return serial
+    return (_read("/sys/devices/soc0/serial_number").strip()
+            or _read("/sys/class/android_usb/android0/iSerial").strip())
+
+  def get_imei(self, slot):
+    # base default (tici reads the modem via DBus); no managed modem here.
+    return ""
+
+  def get_sim_info(self):
+    # base default (ABSENT); tici builds this from the modem/DBus state.
+    return {
+      'sim_id': '',
+      'mcc_mnc': None,
+      'network_type': ["Unknown"],
+      'sim_state': ["ABSENT"],
+      'data_connected': False,
+    }
+
+  def get_sim_lpa(self):
+    # base raises NotImplementedError("SIM LPA not available"); overridden so no
+    # caller can hit that at runtime. No eSIM stack on this base.
+    return None
+
+  def get_network_type(self):
+    # tici sniffs the default route and falls back to modem state; no modem here.
+    iface = _default_route_iface()
+    if iface:
+      if iface.startswith("wlan"):
+        return NetworkType.wifi
+      if iface.startswith("eth"):
+        return NetworkType.ethernet
+    return NetworkType.none
+
+  def get_network_info(self):
+    # tici builds a modem dict; None is the documented "no managed modem" answer.
+    return None
+
+  def get_network_strength(self, network_type):
+    # tici algorithm; the cellular branch is dropped (no modem state).
+    if network_type == NetworkType.ethernet:
+      return NetworkStrength.great
+    if network_type == NetworkType.wifi:
+      rssi = wpa_supplicant_cmd("SIGNAL_POLL").get("RSSI")
+      try:
+        dbm = int(rssi) if rssi is not None else None
+      except (TypeError, ValueError):
+        dbm = None
+      if dbm is not None and -100 < dbm <= 0:
+        pct = 120 + max(-100, min(-20, dbm))
+        if pct < 25:
+          return NetworkStrength.poor
+        if pct < 50:
+          return NetworkStrength.moderate
+        if pct < 75:
+          return NetworkStrength.good
+        return NetworkStrength.great
+    return super().get_network_strength(network_type)
+
+  def get_network_metered(self, network_type) -> bool:
+    # base default is correct here (wifi/ethernet unmetered); tici needs modem
+    # iccid + NetworkManager keyfiles to decide otherwise.
+    return super().get_network_metered(network_type)
+
+  def get_networks(self):
+    # tici scans wlan via iwlist and parses the modem's LTE extras. Without a
+    # managed modem there is nothing meaningful to report.
+    return None
+
+  def get_modem_version(self):
+    return None
+
+  def get_modem_nv(self):
+    return None
+
+  def get_modem_temperatures(self):
+    return []
+
+  def get_modem_data_usage(self):
+    return -1, -1
+
+  def configure_modem(self):
+    # tici sends AT/QNV commands over ModemManager; no managed modem here.
+    pass
+
+  def get_sound_card_online(self):
+    # tici reads /proc/asound/card0/state; the OnePlus 6T base may not publish it,
+    # and soundd only uses this to decide whether to skip audio.
+    return _read("/proc/asound/card0/state").strip() == "ONLINE"
+
+  def get_current_power_draw(self):
+    # tici reads /sys/class/hwmon/hwmon1/power1_input (absent). Stays numeric:
+    # power_monitoring feeds it straight into integration.
+    return 0.0
+
+  def get_som_power_draw(self):
+    # tici multiplies BMS voltage/current; there is no comma BMS on a phone.
+    return 0.0
+
+  def get_voltage(self) -> float:
+    # tici reads hwmon1; absent here -> base default.
+    return 0.
+
+  def get_current(self) -> float:
+    return 0.
+
+  def get_thermal_config(self):
+    # tici's SDM845 zone table. ThermalZone.read() returns 0 for a zone it cannot
+    # find, but its /sys listdir is not guarded, so bail out when the class is
+    # missing entirely.
+    if not os.path.isdir(THERMAL_ROOT):
+      return ThermalConfig()
+    return ThermalConfig(cpu=[ThermalZone(f"cpu{{i}}-silver-usr") for i in range(4)] +
+                             [ThermalZone(f"cpu{{i}}-gold-usr") for i in range(4)],
+                         gpu=[ThermalZone("gpu0-usr"), ThermalZone("gpu1-usr")],
+                         dsp=ThermalZone("compute-hvx-usr"),
+                         memory=ThermalZone("ddr-usr"),
+                         pmic=[ThermalZone("pm8998_tz"), ThermalZone("pm8005_tz")])
+
+  def get_gpu_usage_percent(self):
+    # tici reads kgsl gpubusy; guarded so a missing node yields 0.
+    try:
+      used, total = _read(f"{{KGSL}}/gpubusy").strip().split()
+      return 100.0 * int(used) / int(total)
+    except Exception:
+      return 0
+
+  def get_nvme_temperatures(self):
+    # no NVMe on a phone (tici shells out to smartctl).
+    return []
+
+  def set_display_power(self, on: bool):
+    # tici writes bl_power (0 on / 4 off); guarded.
+    _write(f"{{BACKLIGHT}}/bl_power", "0" if on else "4")
+
+  def set_screen_brightness(self, percentage):
+    # tici scales against max_brightness; guarded.
+    try:
+      max_brightness = float(_read(f"{{BACKLIGHT}}/max_brightness").strip())
+      if max_brightness > 0:
+        _write(f"{{BACKLIGHT}}/brightness", int(percentage * (max_brightness / 100.)))
+    except Exception:
+      pass
+
+  def get_screen_brightness(self):
+    # tici reads it back off the same node; 0 on failure (base default too).
+    try:
+      max_brightness = float(_read(f"{{BACKLIGHT}}/max_brightness").strip())
+      if max_brightness > 0:
+        return int(float(_read(f"{{BACKLIGHT}}/brightness").strip()) / (max_brightness / 100.))
+    except Exception:
+      pass
+    return 0
+
+  def booted(self):
+    # tici gates startup on an msm_vidc debugfs state that is not guaranteed here;
+    # returning True keeps hardwared from blocking offroad forever.
+    # ASSUMED: check /sys/kernel/debug/msm_vidc/core0/info before re-enabling.
+    return True
+
+  def initialize_hardware(self):
+    # tici does amp init, `chmod a+w /dev/kmsg`, SOM_ST_IO fan GPIO, msm_vidc
+    # debugfs writes, IRQ affinity and a pgrep/chrt/taskset dance. None of that
+    # carrier-board plumbing exists here. Keep only guarded, optional writes.
+    gpu_gov = f"{{KGSL}}/devfreq/governor"
+    if os.path.exists(gpu_gov):
+      _write_sudo(gpu_gov, "performance")
+
+  def set_power_save(self, powersave_enabled):
+    # tici's amplifier branch is dropped (no amp). CPU part kept, but every node
+    # is existence-checked first so no sudo call is spent on absent paths.
+    for i in range(4, 8):
+      path = f"/sys/devices/system/cpu/cpu{{i}}/online"
+      if os.path.exists(path):
+        _write_sudo(path, "0" if powersave_enabled else "1")
+
+    for n in ("0", "4"):
+      if powersave_enabled and n == "4":
+        continue
+      gov = f"/sys/devices/system/cpu/cpufreq/policy{{n}}/scaling_governor"
+      if os.path.exists(gov):
+        _write_sudo(gov, "ondemand" if powersave_enabled else "performance")
+
+  def reboot(self, reason=None):
+    try:
+      subprocess.run(["sudo", "reboot"], check=False, timeout=10)
+    except Exception:
+      pass
+
+  def shutdown(self):
+    try:
+      subprocess.run(["sudo", "poweroff"], check=False, timeout=10)
+    except Exception:
+      pass
+
+  def uninstall(self):
+    # tici touches /data/__system_reset__ then reboots; guarded write.
+    try:
+      with open(DATA_RESET_MARKER, "w"):
+        pass
+      os.sync()
+    except Exception:
+      pass
+    self.reboot()
+
+  def set_ir_power(self, percent: int):
+    # base no-op; tici drives led:switch_2 / led:torch_2 (no IR LED here).
+    pass
+
+  def reset_internal_panda(self):
+    # tici toggles STM_RST_N/STM_BOOT0 on the carrier board; on the 6T the panda
+    # is a USB device, so there is nothing to reset.
+    pass
+
+  def recover_internal_panda(self):
+    pass
+
+  def has_internal_panda(self):
+    # no carrier-board panda on a phone; panda is external/USB.
+    return False
+
+# The spec name for this class is Fajita; keep the branch naming convention
+# (Tici / Pc) as the primary symbol and expose the alias.
+Fajita = HardwareFajita
